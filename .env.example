# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finsentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MinIO (S3-compatible storage)
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=rustfsadmin
APP_STORAGE_SECRET_KEY=rustfsadmin
APP_STORAGE_BUCKET=finsentinel
APP_STORAGE_REGION=us-east-1

# Hibernate
HIBERNATE_DDL_AUTO=update

# AI - OpenRouter (REQUIRED)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=google/gemini-3-flash-preview

# Market Data - Polygon.io (REQUIRED)
POLYGON_API_KEY=your-polygon-key-here

# OpenBB Public Data (optional, requires running OpenBB API service)
APP_OPENBB_ENABLED=false
OPENBB_BASE_URL=http://localhost:6900
OPENBB_API_PREFIX=/api/v1
OPENBB_API_KEY=
OPENBB_BLS_API_KEY=
OPENBB_CONGRESS_GOV_API_KEY=
OPENBB_CFTC_APP_TOKEN=
OPENBB_FRED_API_KEY=
OPENBB_POLYGON_API_KEY=
OPENBB_US_EIA_API_KEY=
OPENBB_BUSINESS_MACRO_PROVIDER=fred
OPENBB_BUSINESS_CPI_PATH=economy/cpi
OPENBB_BUSINESS_UNEMPLOYMENT_PATH=economy/unemployment
OPENBB_BUSINESS_FED_FUNDS_PATH=economy/federal_funds_rate
OPENBB_BUSINESS_CPI_SERIES_ID=CPIAUCSL
OPENBB_BUSINESS_UNEMPLOYMENT_SERIES_ID=UNRATE
OPENBB_BUSINESS_FED_FUNDS_SERIES_ID=FEDFUNDS

# Firecrawl (optional)
FIRECRAWL_API_KEY=

# X (Twitter) API - Financial Influencer Scraper (optional)
APP_X_ENABLED=false
X_BEARER_TOKEN=your-x-bearer-token-here
APP_X_POLL_INTERVAL=300000
APP_X_MAX_RESULTS=10

# Autonomy (optional)
APP_AUTONOMY_HEARTBEAT_ENABLED=true
APP_AUTONOMY_HEARTBEAT_DISPATCH_MS=30000
APP_AUTONOMY_HEARTBEAT_DEFAULT_SECONDS=600
APP_AUTONOMY_HEARTBEAT_MIN_SECONDS=60
APP_AUTONOMY_HEARTBEAT_MAX_SECONDS=3600
APP_AUTONOMY_HEARTBEAT_DRAWDOWN_PCT=10.00
APP_CHAT_COMPACTION_ENABLED=true
APP_CHAT_COMPACTION_THRESHOLD_MESSAGES=24
APP_CHAT_COMPACTION_RECENT_WINDOW=10
APP_CHAT_COMPACTION_MAX_SUMMARY_CHARS=1200

# MCP Server (optional — enables Claude Desktop / MCP client integration)
MCP_SERVER_ENABLED=false
MCP_API_KEY=change-this-to-a-random-secret
MCP_USER_ID=00000000-0000-0000-0000-000000000000

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRATION=86400000

# 6551.io - Crypto News & Twitter Data (optional)
APP_CRYPTO_NEWS_ENABLED=false
CRYPTO_NEWS_6551_TOKEN=your-6551-api-token
CRYPTO_NEWS_MIN_SCORE=70
APP_TWITTER_6551_ENABLED=false
TWITTER_6551_TOKEN=your-6551-api-token

# OKX Exchange (optional — crypto spot, futures, margin trading)
APP_OKX_ENABLED=false
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase
OKX_SANDBOX=false
OKX_WEBSOCKET_ENABLED=true

# Encryption key for API key storage (generate: openssl rand -base64 32)
APP_ENCRYPTION_AES_KEY=

# News Archival to Google Drive (optional, requires hybrid storage mode)
APP_ARCHIVAL_ENABLED=false
