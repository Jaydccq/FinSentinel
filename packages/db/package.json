{
  "name": "@finsentinel/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/apply-migrations.ts",
    "db:migrate:status": "tsx src/apply-migrations.ts status",
    "db:migrate:bootstrap": "tsx src/apply-migrations.ts --bootstrap-from=11",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@finsentinel/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}
