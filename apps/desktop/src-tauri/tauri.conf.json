{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FinSentinel",
  "version": "0.1.0",
  "identifier": "com.finsentinel.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @finsentinel/web dev",
    "beforeBuildCommand": "NEXT_PUBLIC_TAURI=1 pnpm --filter @finsentinel/web build"
  },
  "app": {
    "windows": [
      {
        "title": "FinSentinel",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost ipc: https://api.finsentinel.example; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.finsentinel.example"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
