# apps/web Next.js environment — only NEXT_PUBLIC_* vars here.
#
# Next.js dev/build reads `.env*` relative to apps/web/, NOT the
# monorepo root. Keep a local `.env.local` (gitignored) with values
# that match the root .env seed credentials.
#
# Server-side secrets (DATABASE_URL, JWT_SECRET, OPENROUTER_API_KEY, etc.)
# belong in the root .env and are loaded by the NestJS API only — do
# NOT copy them here, they would be bundled into the browser JS.

# Production Tauri builds only (absolute URL to the remote NestJS API).
# Leave unset in dev — apiFetch will use a relative /api/* path that the
# Next dev server's rewrite proxies to localhost:3001.
# NEXT_PUBLIC_API_BASE_URL=https://api.finsentinel.example
