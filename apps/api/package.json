{
  "name": "@finsentinel/api",
  "version": "0.0.1",
  "private": true,
  "description": "FinSentinel NestJS API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "rag:golden:export": "tsx src/rag/eval/golden-candidates.cli.ts",
    "rag:eval:seed-fixture": "tsx src/rag/eval/seed-fixture.cli.ts",
    "rag:backfill:chunk-issuer-tickers": "tsx src/rag/admin/rag-backfill-chunk-issuer-tickers.cli.ts",
    "rag:backfill:representations": "tsx src/rag/admin/rag-backfill-representations.cli.ts",
    "rag:backfill:sparse": "tsx src/rag/admin/rag-backfill-representation-sparse.cli.ts",
    "rag:reindex:by-doctype": "tsx src/rag/admin/rag-reindex-by-doctype.cli.ts",
    "rag:repr:reindex": "tsx src/rag/admin/rag-repr-reindex.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@finsentinel/ai-runtime": "workspace:*",
    "@finsentinel/db": "workspace:*",
    "@finsentinel/shared": "workspace:*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.44.7",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.2",
    "technicalindicators": "^3.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@swc/cli": "^0.7.0",
    "@swc/core": "^1.11.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.2"
  }
}
