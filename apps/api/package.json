{
  "name": "@finsentinel/api",
  "version": "0.0.1",
  "private": true,
  "description": "FinSentinel NestJS API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@finsentinel/db": "workspace:*",
    "@finsentinel/shared": "workspace:*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "ai": "^6.0.141",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.7",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.2",
    "technicalindicators": "^3.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@swc/cli": "^0.7.0",
    "@swc/core": "^1.11.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.2"
  }
}
