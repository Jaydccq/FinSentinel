{
  "name": "finsentinel",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter=!@finsentinel/desktop",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --filter=!@finsentinel/desktop",
    "test:all": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:no-vercel-ai-sdk": "node scripts/check-no-vercel-ai-sdk.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@nestjs/core"
    ]
  }
}
