# ============================================================
# Environment variables for the TypeScript stack
# Copy to .env and fill in the values
# ============================================================

# --- Infrastructure (must match docker-compose.dev.yml) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finsentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=finsentinel

# Composed DATABASE_URL for ORMs (Drizzle, Prisma, etc.)
DATABASE_URL=postgresql://postgres:finsentinel@localhost:5432/finsentinel

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- AI / LLM -----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=google/gemini-3-flash-preview

# --- Market Data --------------------------------------------
POLYGON_API_KEY=your-polygon-key-here

# --- Auth ---------------------------------------------------
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRATION=86400000

# --- Optional: 6551.io Crypto News & Twitter ----------------
APP_CRYPTO_NEWS_ENABLED=false
CRYPTO_NEWS_6551_TOKEN=
APP_TWITTER_6551_ENABLED=false
TWITTER_6551_TOKEN=

# --- Optional: OKX Exchange ---------------------------------
APP_OKX_ENABLED=false
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
